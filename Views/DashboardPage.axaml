<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:qiyana.ViewModels"
             xmlns:models="using:qiyana.Models"
             xmlns:matchdata="using:qiyana.Models.MatchData"
             xmlns:local="using:qiyana.Views"
             xmlns:conv="using:qiyana.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="qiyana.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             x:Name="ThisControl">
    <UserControl.Resources>
        <conv:WinToBackgroundConverter x:Key="WinToBackground" />
        <conv:SecondsToDurationConverter x:Key="SecondsToDuration" />
        <conv:EpochToRelativeTimeConverter x:Key="EpochToRelativeTime" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
        <conv:FilterTabBackgroundConverter x:Key="FilterTab" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <conv:BytesToBitmapConverter x:Key="BytesToBitmap" />
        <conv:LcuAssetConverter x:Key="LcuAsset" />
    </UserControl.Resources>

    <DockPanel>
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="{Binding IsLoading}"
                     IsVisible="{Binding IsLoading}"
                     Height="4" />

        <Grid RowDefinitions="Auto,Auto,*">
            <!-- ========== 顶部: 我的信息 ========== -->
            <Border Grid.Row="0" Background="#1e1e2e" Padding="16" Margin="0"
                    IsVisible="{Binding Summoner, Converter={StaticResource IsNotNull}}">
                <local:SummonerInfoPanel DataContext="{Binding Summoner}" />
            </Border>

            <!-- ========== 筛选栏 ========== -->
            <Border Grid.Row="1" Background="#1e1e2e" Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="全部"
                            Command="{Binding FilterCommand}" CommandParameter="All"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=All}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                    <Button Content="单双排位"
                            Command="{Binding FilterCommand}" CommandParameter="SoloDuo"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=SoloDuo}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                    <Button Content="灵活排位"
                            Command="{Binding FilterCommand}" CommandParameter="Flex"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=Flex}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                    <Button Content="匹配模式"
                            Command="{Binding FilterCommand}" CommandParameter="Normal"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=Normal}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                    <Button Content="极地大乱斗"
                            Command="{Binding FilterCommand}" CommandParameter="ARAM"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=ARAM}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                    <Button Content="海克斯大乱斗"
                            Command="{Binding FilterCommand}" CommandParameter="HextechAram"
                            Background="{Binding SelectedFilter, Converter={StaticResource FilterTab}, ConverterParameter=HextechAram}"
                            Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- ========== 底部: 左右分栏 ========== -->
            <Grid Grid.Row="2" ColumnDefinitions="2*,8*" Background="#1a1a2e">

                <!-- 左: 战绩列表 -->
                <Grid Grid.Column="0" Name="MatchListContainer" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#ff6b6b"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                               FontSize="13" />

                    <ListBox Grid.Row="1"
                             Name="MatchListBox"
                             ItemsSource="{Binding Matches}"
                             SelectedItem="{Binding SelectedMatch}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Loaded="MatchListBox_OnLoaded"
                             x:CompileBindings="False">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background"
                                        Value="{Binding Win, Converter={StaticResource WinToBackground}}" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                Margin="{TemplateBinding Margin}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background"
                                        Value="{Binding Win, Converter={StaticResource WinToBackground}, ConverterParameter=Highlight}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background"
                                        Value="{Binding Win, Converter={StaticResource WinToBackground}, ConverterParameter=Highlight}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover">
                                <Setter Property="Background"
                                        Value="{Binding Win, Converter={StaticResource WinToBackground}, ConverterParameter=Highlight}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="matchdata:GameDetail">
                                <Border Padding="12" Background="Transparent">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="48" Height="48"
                                                Background="#1a1a2e" VerticalAlignment="Center"
                                                ClipToBounds="True">
                                            <Image Source="{Binding ChampionIcon, Converter={StaticResource BytesToBitmap}}"
                                                   Width="48" Height="48" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontSize="15" FontWeight="Bold">
                                                <Run Text="{Binding Kills}" Foreground="{Binding KillsForeground}"/>
                                                <Run Text=" / " Foreground="#666"/>
                                                <Run Text="{Binding Deaths}" Foreground="{Binding DeathsForeground}"/>
                                                <Run Text=" / " Foreground="#666"/>
                                                <Run Text="{Binding Assists}" Foreground="{Binding AssistsForeground}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#aaa" FontSize="12"
                                                       Text="{Binding QueueDisplayName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Duration, Converter={StaticResource SecondsToDuration}}"
                                                       Foreground="#ccc" FontSize="13" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Timestamp, Converter={StaticResource EpochToRelativeTime}}"
                                                       Foreground="#888" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ProgressBar Grid.Row="2"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsLoadingMore}"
                                 Height="3" Margin="0,4" />

                    <TextBlock Grid.Row="3"
                                Text="没有更多对局"
                               Foreground="#666" FontSize="13"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding HasMore, Converter={StaticResource InvertBool}}"
                               Margin="0,8" />
                </Grid>

                <Grid Grid.Column="1">
                    <Grid IsVisible="{Binding ShowDetailPanel}">
                        <local:ScoreboardPanel DataContext="{Binding SelectedDetail}"
                                               PlayerNameClicked="OnScoreboardPlayerNameClicked" />
                    </Grid>
                    <Grid Background="#1a1a2e"
                          IsVisible="{Binding ShowDetailPanel, Converter={StaticResource InvertBool}}">
                    <TextBlock Text="选择一个对局查看详情"
                               Foreground="#666" FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>