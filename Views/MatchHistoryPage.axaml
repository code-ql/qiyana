<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:qiyana.ViewModels"
             xmlns:models="using:qiyana.Models"
             xmlns:local="using:qiyana.Views"
             xmlns:conv="using:qiyana.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="qiyana.Views.MatchHistoryPage"
             x:DataType="vm:MatchHistoryViewModel"
             x:CompileBindings="False"
              Focusable="True"
              x:Name="ThisControl">

    <UserControl.Resources>
        <conv:WinToBackgroundConverter x:Key="WinToBackground"/>
        <conv:SecondsToDurationConverter x:Key="SecondsToDuration"/>
        <conv:EpochToRelativeTimeConverter x:Key="EpochToRelativeTime"/>
        <conv:IsNotNullConverter x:Key="IsNotNull"/>
        <conv:FilterTabBackgroundConverter x:Key="FilterTab"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:BoolToHighlightConverter x:Key="BoolToHighlight"/>
        <conv:BytesToBitmapConverter x:Key="BytesToBitmap"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ========== 顶部: 搜索框 + 历史下拉 ========== -->
        <Border Grid.Row="0" Background="#1e1e2e" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="600">
                    <Grid MinWidth="300">
                        <TextBox Text="{Binding SearchText}"
                                 PlaceholderText="搜索召唤师..."
                                 KeyDown="OnSearchKeyDown"
                                 GotFocus="OnSearchBoxGotFocus"
                                   LostFocus="OnSearchBoxLostFocus"
                                   PointerPressed="OnSearchBoxPointerPressed"
                                    FontSize="14" Padding="8,6"/>
                        <Button Content="搜索"
                                Command="{Binding SearchCommand}"
                                Background="#4a9eff" Foreground="White" FontSize="13"
                                Padding="12,6" BorderThickness="0"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right"/>
                        <Popup IsOpen="{Binding ShowHistory}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="2"
                               Width="{Binding Bounds.Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TextBox}}}">
                             <Border Background="#2b2b3d"
                                    BorderBrush="#3a3a5c" BorderThickness="1"
                                    MinWidth="300" MaxHeight="300">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MatchHistorySearch"
                                x:CompileBindings="False">
                                                 <Border Background="Transparent" MinHeight="36"
                                                          PointerPressed="OnHistoryItemPointerPressed">
                                                     <StackPanel Margin="12,4">
                                                         <TextBlock Text="{Binding DisplayName}"
                                                                    Foreground="White" FontSize="13"
                                                                    TextTrimming="CharacterEllipsis"/>
                                                         <TextBlock Text="{Binding LastSearchedAt, StringFormat={}{0:g}}"
                                                                    Foreground="#888" FontSize="10"/>
                                                     </StackPanel>
                                                 </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== Tab 栏 ========== -->
        <Border Grid.Row="1" Background="#1a1a2e" Padding="8,0"
                IsVisible="{Binding NoTabs, Converter={StaticResource InvertBool}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MatchHistoryTab"
                        x:CompileBindings="False">
                            <Border Padding="8,6"
                                    Background="{Binding IsActive, Converter={StaticResource BoolToHighlight}}"
                                    PointerPressed="OnTabPointerPressed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Summoner.GameName}"
                                               Foreground="White" FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="120"/>
                                    <Button Content="×"
                                            Command="{Binding $parent[UserControl].DataContext.CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#888"
                                            FontSize="14" Width="20" Height="20"
                                            BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ========== 内容区 ========== -->
        <Border Grid.Row="2" IsVisible="{Binding NoTabs, Converter={StaticResource InvertBool}}"
                Background="#2b2b3d">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Top"
                             IsIndeterminate="True"
                             IsVisible="{Binding CurrentTab.IsLoading}"
                             Height="4"/>

                <Grid RowDefinitions="Auto,Auto,*" Background="#2b2b3d">
                    <!-- 召唤师信息 -->
                    <Border Grid.Row="0" Background="#1e1e2e" Padding="16" Margin="0"
                            IsVisible="{Binding CurrentTab.Summoner, Converter={StaticResource IsNotNull}}">
                        <local:SummonerInfoPanel DataContext="{Binding CurrentTab.Summoner}"/>
                    </Border>

                    <!-- 筛选栏 -->
                    <Border Grid.Row="1" Background="#1e1e2e" Padding="12" Margin="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="全部"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="All"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                            <Button Content="单双排位"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="SoloDuo"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                            <Button Content="灵活排位"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="Flex"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                            <Button Content="匹配模式"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="Normal"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                            <Button Content="极地大乱斗"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="ARAM"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                            <Button Content="海克斯大乱斗"
                                    Command="{Binding CurrentTab.FilterCommand}" CommandParameter="HextechAram"
                                    Background="Transparent"
                                    Foreground="White" FontSize="13" Padding="12,4" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 底部: 左右分栏 -->
                    <Grid Grid.Row="2" ColumnDefinitions="2*,8*" Margin="0" Background="#1a1a2e">
                        <local:MatchHistoryList Grid.Column="0"/>
                        <local:MatchDetailPanel Grid.Column="1"/>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 空状态 -->
        <Border Grid.Row="2" IsVisible="{Binding NoTabs}" Background="#2b2b3d">
            <TextBlock Text="搜索召唤师以查看战绩"
                       Foreground="#666" FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
