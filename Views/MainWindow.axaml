<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:qiyana.ViewModels"
        xmlns:conv="using:qiyana.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="qiyana.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="qiyana">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:LcuAssetConverter x:Key="LcuAsset"/>
        <conv:IsNotNullConverter x:Key="IsNotNull"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8">
                                <Image Source="{Binding ProfileIconPath, Converter={StaticResource LcuAsset}}"
                                       Width="32" Height="32" ClipToBounds="True"
                                       IsVisible="{Binding ProfileIconPath, Converter={StaticResource IsNotNull}}"/>
                                <TextBlock Text="{Binding IconText}" FontSize="16"
                                           IsVisible="{Binding ProfileIconPath, Converter={StaticResource IsNotNull}, ConverterParameter=invert}"/>
                                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1">
                    <Border Background="#1e1e2e" Cursor="Hand"
                            PointerPressed="OnWebsitePointerPressed" Padding="12,8" Margin="0,0,0,2">
                        <Path Data="M11.5 1a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0V2.71l-4.15 4.15a.5.5 0 1 1-.7-.7L10.29 2H9.5a.5.5 0 0 1 0-1h2zM5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7.5a.5.5 0 0 0-1 0V11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5a.5.5 0 0 0 0-1H5z"
                              Fill="#ccc" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#1e1e2e" Cursor="Hand"
                            PointerPressed="OnGithubPointerPressed" Padding="12,8" Margin="0,2,0,0">
                        <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                              Fill="#ccc" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Collapse Splitter -->
        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                PointerPressed="OnSplitterPointerPressed"
                PointerEntered="OnSplitterPointerEntered"
                PointerExited="OnSplitterPointerExited">
            <Rectangle Width="1" HorizontalAlignment="Center"
                       Fill="Transparent"/>
        </Border>

        <!-- Right Content Area -->
        <Border Grid.Column="2" Padding="0,0,0,0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </Grid>
</Window>
