<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="qiyana.App"
             xmlns:local="using:qiyana"
             xmlns:vm="using:qiyana.ViewModels"
             xmlns:views="using:qiyana.Views"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchHistoryViewModel}">
            <views:MatchHistoryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveGameViewModel}">
            <views:LiveGamePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InGameViewModel}">
            <views:InGamePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>

        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme  />
    </Application.Styles>
</Application>